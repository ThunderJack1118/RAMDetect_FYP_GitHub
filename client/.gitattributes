# Git LFS is optional but recommended if model files grow in future.
# Run: git lfs install
# Run: git lfs track "*.pkl" "*.keras" "*.h5" "*.joblib"

*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.exe binary
*.pkl binary
*.keras binary
*.h5 binary
*.joblib binary
*.dmp filter=lfs diff=lfs merge=lfs -text
*.raw filter=lfs diff=lfs merge=lfs -text
*.mem filter=lfs diff=lfs merge=lfs -text
*.vmem filter=lfs diff=lfs merge=lfs -text
